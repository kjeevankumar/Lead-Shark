# Lead Shark Backend Environment Variables
ENVIRONMENT=development
PORT=8000
DATABASE_URL=sqlite:///./lead_shark.db
# For Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

SECRET_KEY=leadshark-super-secret-production-grade-key-2026
FRONTEND_ORIGIN=*

# RAG Lead Segregation Agent
RAG_AGENT_URL=http://localhost:8001

# Email Sending & Compliance (Safe Demo by default)
SENDING_MODE=safe_demo
SENDING_DOMAIN=mail.leadshark.io
COMPANY_POSTAL_ADDRESS=100 Market St, Suite 400, San Francisco, CA 94105, USA
EMAIL_PROVIDER_API_KEY=

# Optional Commercial External Search Provider Keys (Free OSM/Wikidata/Directory active by default)
GOOGLE_PLACES_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
